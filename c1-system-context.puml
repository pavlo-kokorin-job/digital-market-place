@startuml C4 Level 1
!include <C4/C4_Container>

title C4 Level 1: System Context - Digital Marketplace

Person(buyer, "Buyer", "A customer who browses products and places orders.")
Person(seller, "Seller", "A vendor who lists products and approves fulfillment.")

System(system, "Digital Marketplace", "Enables product browsing, ordering, payment, and fulfillment.")

System_Ext(payment, "Payment Service Provider", "Processes buyer payments securely.")
System_Ext(logistics, "Logistics Partner", "Handles shipping and delivery of products.")
System_Ext(notification, "Notification Service", "Sends emails and SMS updates to users.")

Rel(buyer, system, "Places orders, makes payments, tracks status")
Rel(seller, system, "Manages products and approves orders")
Rel(system, payment, "Processes payments through")
Rel(system, logistics, "Requests shipping and tracks delivery")
Rel(system, notification, "Sends notifications via")

SHOW_LEGEND()
@enduml
